---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <div class="breadcrumbs text-sm mb-6">
        <ul>
            <li><a href="/">Accueil</a></li>
            <li>Simple Penguin</li>
        </ul>
    </div>

    <h1 class="text-center mb-6 text-3xl font-extrabold">2. Simple Penguin</h1>

    <figure class="flex flex-col items-center gap-4">
        <!-- La div qui va recevoir le graphique -->
        <div
            id="graphique"
            class="w-full flex justify-center min-h-[400px] overflow-x-auto"
        >
        </div>
    </figure>
</Layout>

<script>
    // 1. Importation de la librairie et des données
    import * as Plot from "@observablehq/plot";
    // Vérifie bien que le chemin vers ton JSON est correct (d'après tes captures précédentes, il est dans src/data/)
    import penguins from "../data/penguins.json";

    function initGraph() {
        const divGraphique = document.querySelector("#graphique");
        if (!divGraphique) return;

        // 2. Vider l'affichage précédent
        divGraphique.innerHTML = "";

        // 3. Création du nuage de points avec les données réelles
        const plot = Plot.plot({
            marks: [
                Plot.dot(penguins, {
                    x: "culmen_length_mm",
                    y: "culmen_depth_mm",
                    stroke: "species",
                }),
            ],
        });

        // 4. Ajout à la page
        divGraphique.append(plot);
    }

    // Sécurité pour l'affichage (chargement normal ou via transitions Astro)
    document.addEventListener("DOMContentLoaded", initGraph);
    document.addEventListener("astro:page-load", initGraph);
</script>