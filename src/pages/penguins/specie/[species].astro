---
import Layout from "../../../layouts/Layout.astro";
import penguins from "../../../data/penguins.json";

// 1. Fonction OBLIGATOIRE qui dit à Astro quelles pages générer
export function getStaticPaths() {
    const speciesList = [...new Set(penguins.map((p) => p.species))];

    // On retourne un tableau d'objets contenant les paramètres
    return speciesList.map((species) => {
        return {
            params: { species: species },
        };
    });
}

// 2. On récupère le nom de l'espèce pour la page en cours de génération
const { species } = Astro.params;
---

<Layout>
    <div class="breadcrumbs text-sm mb-6">
        <ul>
            <li><a href="/">Accueil</a></li>
            <li><a href="/penguins">Pingouins</a></li>
            <li><a href="/penguins/specie">Espèces (Index)</a></li>
            <li class="font-bold">{species}</li>
        </ul>
    </div>

    <h1 class="text-center mb-6 text-3xl font-extrabold">Espèce : {species}</h1>

    <!-- On stocke le nom de l'espèce dans un attribut data-species pour le JavaScript -->
    <div
        id="graphique"
        class="w-full flex justify-center min-h-[400px] overflow-x-auto"
        data-species={species}
    >
    </div>
</Layout>

<script>
    import * as Plot from "@observablehq/plot";
    import penguins from "../../../data/penguins.json";

    function renderPlot() {
        const container = document.querySelector("#graphique");
        if (!container) return;

        container.innerHTML = "";
        // On récupère le nom de l'espèce depuis le HTML
        const currentSpecies = container.getAttribute("data-species");

        const plot = Plot.plot({
            color: { legend: true },
            marks: [
                Plot.dot(penguins, {
                    x: "culmen_length_mm",
                    y: "culmen_depth_mm",
                    stroke: "species",
                    // On filtre uniquement les points de cette espèce
                    filter: (d) => d.species === currentSpecies,
                }),
            ],
        });

        container.append(plot);
    }

    document.addEventListener("DOMContentLoaded", renderPlot);
    document.addEventListener("astro:page-load", renderPlot);
</script>
