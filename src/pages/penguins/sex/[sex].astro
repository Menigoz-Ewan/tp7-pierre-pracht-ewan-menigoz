---
import Layout from "../../../layouts/Layout.astro";
import penguins from "../../../data/penguins.json";

export function getStaticPaths() {
    const sexList = [...new Set(penguins.map((p) => p.sex).filter(Boolean))];

    return sexList.map((sex) => {
        return {
            params: { sex: sex },
        };
    });
}

const { sex } = Astro.params;
---

<Layout>
    <div class="breadcrumbs text-sm mb-6">
        <ul>
            <li><a href="/">Accueil</a></li>
            <li><a href="/penguins">Pingouins</a></li>
            <li><a href="/penguins/sex">Sexes (Index)</a></li>
            <li class="font-bold">{sex}</li>
        </ul>
    </div>

    <h1 class="text-center mb-6 text-3xl font-extrabold">Sexe : {sex}</h1>

    <div
        id="graphique"
        class="w-full flex justify-center min-h-[400px] overflow-x-auto"
        data-sex={sex}
    >
    </div>
</Layout>

<script>
    import * as Plot from "@observablehq/plot";
    import penguins from "../../../data/penguins.json";

    function renderPlot() {
        const container = document.querySelector("#graphique");
        if (!container) return;

        container.innerHTML = "";
        const currentSex = container.getAttribute("data-sex");

        const plot = Plot.plot({
            color: { legend: true },
            marks: [
                Plot.dot(penguins, {
                    x: "culmen_length_mm",
                    y: "culmen_depth_mm",
                    stroke: "sex",
                    filter: (d) => d.sex === currentSex,
                }),
            ],
        });

        container.append(plot);
    }

    document.addEventListener("DOMContentLoaded", renderPlot);
    document.addEventListener("astro:page-load", renderPlot);
</script>
