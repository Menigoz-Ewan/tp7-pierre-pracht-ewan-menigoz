---
import Layout from "../../layouts/Layout.astro";
---

<Layout>
    <div class="breadcrumbs text-sm mb-6">
        <ul>
            <li><a href="/">Accueil</a></li>
            <li><a href="/pizzas">Pizzas</a></li>
            <li>Pizza avec filtre</li>
        </ul>
    </div>

    <h1 class="text-center mb-6 text-3xl font-extrabold">
        3. Pizza - Filtre unique
    </h1>

    <div class="flex justify-center mb-8">
        <select
            id="pizzaCategory"
            class="select select-bordered select-primary w-full max-w-xs text-lg"
        >
            <option value="">Toutes les catégories</option>
            <option value="Classic">Classic</option>
            <option value="Specialty">Specialty</option>
            <option value="Vegetarian">Vegetarian</option>
        </select>
    </div>

    <figure class="flex flex-col items-center gap-4">
        <div
            id="graphique"
            class="w-full flex justify-center min-h-[400px] overflow-x-auto"
        >
        </div>
    </figure>
</Layout>

<script>
    import * as Plot from "@observablehq/plot";
    import pizzaData from "../../data/pizzas.json";

    function initPage() {
        const selectCategory = document.querySelector(
            "#pizzaCategory",
        ) as HTMLSelectElement;
        const divGraphique = document.querySelector("#graphique");

        if (!selectCategory || !divGraphique) return;

        function renderPlot() {
            const selectedCategory = selectCategory.value;

            divGraphique.innerHTML = "";

            const plot = Plot.plot({
                color: { legend: true },
                x: { label: "Nombre de commandes" },
                y: { label: "Revenus ($)" },
                marks: [
                    Plot.dot(pizzaData, {
                        x: "orders",
                        y: "revenue",
                        stroke: "category",
                        filter: (d) =>
                            selectedCategory === "" ||
                            d.category === selectedCategory,
                    }),
                ],
            });

            divGraphique.append(plot);
        }

        selectCategory.addEventListener("change", renderPlot);
        renderPlot();
    }

    document.addEventListener("DOMContentLoaded", initPage);
    document.addEventListener("astro:page-load", initPage);
</script>
