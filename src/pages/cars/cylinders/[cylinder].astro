---
import Layout from "../../../layouts/Layout.astro";
import cars from "../../../data/cars.json";

export function getStaticPaths() {
    const cylindersList = [...new Set(cars.map((c) => c.cylinders))];

    return cylindersList.map((cylinder) => {
        return {
            // Les paramètres d'URL doivent toujours être des chaînes de caractères (string)
            params: { cylinder: cylinder.toString() },
        };
    });
}

const { cylinder } = Astro.params;
---

<Layout>
    <div class="breadcrumbs text-sm mb-6">
        <ul>
            <li><a href="/">Accueil</a></li>
            <li><a href="/cars">Voitures</a></li>
            <li><a href="/cars/cylinders">Cylindres (Index)</a></li>
            <li class="font-bold">{cylinder}</li>
        </ul>
    </div>

    <h1 class="text-center mb-6 text-3xl font-extrabold">
        Moteurs {cylinder} Cylindres
    </h1>

    <div
        id="graphique"
        class="w-full flex justify-center min-h-[400px] overflow-x-auto"
        data-cylinder={cylinder}
    >
    </div>
</Layout>

<script>
    import * as Plot from "@observablehq/plot";
    import cars from "../../../data/cars.json";

    function renderPlot() {
        const container = document.querySelector("#graphique");
        if (!container) return;

        container.innerHTML = "";
        // Le dataset renvoie une string, on le convertit en nombre pour le filtre
        const currentCylinder = Number(container.getAttribute("data-cylinder"));

        const plot = Plot.plot({
            color: { legend: true, scheme: "viridis", label: "0-60 mph (s)" },
            x: { label: "Puissance (hp)" },
            y: { label: "Poids (lb)" },
            marks: [
                Plot.dot(cars, {
                    x: "power (hp)",
                    y: "weight (lb)",
                    fill: "0-60 mph (s)", // La couleur dépend de l'accélération
                    title: "name", // Infobulle au survol
                    filter: (d) => d.cylinders === currentCylinder,
                }),
            ],
        });

        container.append(plot);
    }

    document.addEventListener("DOMContentLoaded", renderPlot);
    document.addEventListener("astro:page-load", renderPlot);
</script>
