---
import Layout from "../../layouts/Layout.astro";
---

<Layout>
    <div class="breadcrumbs text-sm mb-6">
        <ul>
            <li><a href="/">Accueil</a></li>
            <li>Météo avec filtre</li>
        </ul>
    </div>

    <h1 class="text-center mb-6 text-3xl font-extrabold">
        3. Météo - Filtre unique
    </h1>

    <div class="flex justify-center mb-8">
        <select
            id="weatherType"
            class="select select-bordered select-primary w-full max-w-xs text-lg"
        >
            <option value="">Tous les temps</option>
            <option value="sun">Soleil</option>
            <option value="rain">Pluie</option>
            <option value="drizzle">Bruine</option>
            <option value="snow">Neige</option>
            <option value="fog">Brouillard</option>
        </select>
    </div>

    <figure class="flex flex-col items-center gap-4">
        <div
            id="graphique"
            class="w-full flex justify-center min-h-[400px] overflow-x-auto"
        >
        </div>
    </figure>
</Layout>

<script>
    import * as Plot from "@observablehq/plot";
    import weatherData from "../../data/weather.json";

    function initPage() {
        const selectWeather = document.querySelector(
            "#weatherType",
        ) as HTMLSelectElement;
        const divGraphique = document.querySelector("#graphique");

        if (!selectWeather || !divGraphique) return;

        function renderPlot() {
            const selectedWeather = selectWeather.value;

            divGraphique.innerHTML = "";

            const plot = Plot.plot({
                color: { legend: true },
                x: { label: "Température Min (°C)" },
                y: { label: "Température Max (°C)" },
                marks: [
                    Plot.dot(weatherData, {
                        x: "temp_min",
                        y: "temp_max",
                        stroke: "weather",
                        filter: (d) =>
                            selectedWeather === "" ||
                            d.weather === selectedWeather,
                    }),
                ],
            });

            divGraphique.append(plot);
        }

        selectWeather.addEventListener("change", renderPlot);

        renderPlot();
    }

    document.addEventListener("DOMContentLoaded", initPage);
    document.addEventListener("astro:page-load", initPage);
</script>
