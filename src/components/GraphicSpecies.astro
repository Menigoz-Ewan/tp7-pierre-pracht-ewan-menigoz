---
import * as Plot from "@observablehq/plot";
import PlotFigure from "./PlotFigure.astro";
import penguins from "../data/penguins.json";

const { species } = Astro.props;

const filteredPenguins = penguins.filter((p) => p.species === species);

const plotOptions = {
    grid: true,
    x: { label: "Longueur de la nageoire (mm)" },
    y: { label: "Masse corporelle (g)" },
    color: {
        domain: ["Adelie", "Gentoo", "Chinstrap"],
        range: ["#570df8", "#f000b8", "#37cdbe"],
    },
    marks: [
        Plot.dot(filteredPenguins, {
            x: "flipper_length_mm",
            y: "body_mass_g",
            fill: "species",
            r: 4,
        }),
    ],
};
---

<div class="my-8">
    <h1 class="text-4xl font-extrabold mb-8 text-center text-gray-800">
        {species}
    </h1>
</div>

<PlotFigure options={plotOptions} />
